<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="style.css">
  <script src="https://use.fontawesome.com/releases/v5.7.1/js/all.js"></script>

  <title>Legg til ny plass - OSS AS</title>
</head>

<body>
  <header>
    <nav>
      <ul class="navlinks">
        <li>
          <a href="/home" class="active">
            <i class="fas fa-home"></i> Heim
          </a>
        </li>
        <li>
          <a href="/profile">
            <i class="fas fa-user"></i> Min profil
          </a>
        </li>
        <% if (admin) { %>
          <li>
            <a href="/admin"> <i class="fas fa-cogs"></i> Admin </a>
          </li>
          <% } %>
            <li>
              <a href="/logout">
                <i class="fas fa-sign-out-alt"></i> Logg ut
              </a>
            </li>
      </ul>
    </nav>
  </header>
  
  <main>
    <div class="container">
      <form action="/add-place" method="post">
        <label for="place">Plass</label>
        <input type="text" name="place" required>
  
        <label for="image">Bilde</label>
        <input type="text" name="image" required>
  
        <label>Status</label>
        <div class="radio-group">
          <label>
            <input type="radio" name="visited" value="1" onclick="toggleRating(true)">
            Besøkt
          </label>
          <label>
            <input type="radio" name="visited" value="0" onclick="toggleRating(false)" checked>
            Ikkje besøkt
          </label>
        </div>
  
        <!-- Rating dropdown -->
        <div id="rating-container" style="display: none; margin-top: 10px;">
          <label for="rating">Rating</label>
          <select name="rating" id="rating">
            <option value="">Velg rating</option>
            <option value="1">⭐ 1</option>
            <option value="2">⭐ 2</option>
            <option value="3">⭐ 3</option>
            <option value="4">⭐ 4</option>
            <option value="5">⭐ 5</option>
          </select>
        </div>
  
        <div class="form-buttons">
          <button type="submit" class="btn-primary">Lagre</button>
          <a href="/home" class="btn-cancel">Avbryt</a>
        </div>
      </form>
    </div>
  
    <script>
      function toggleRating(show) {
        document.getElementById("rating-container").style.display = show ? "block" : "none";
      }
    </script>
  </main>
  

  </body>
  
  </html>